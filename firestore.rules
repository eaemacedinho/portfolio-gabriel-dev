rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /leads/{leadId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'name',
          'phone',
          'projectType',
          'idea',
          'source',
          'status',
          'createdAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 8 &&
        request.resource.data.phone.size() <= 24 &&
        request.resource.data.projectType is string &&
        request.resource.data.projectType.size() <= 40 &&
        request.resource.data.idea is string &&
        request.resource.data.idea.size() >= 10 &&
        request.resource.data.idea.size() <= 1500 &&
        request.resource.data.source == 'portfolio' &&
        request.resource.data.status == 'new' &&
        request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }
  }
}
